<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.gamelauncher" name="Game Launcher" version="1.0.0" provider-name="opencode">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>executable game</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Game Launcher</summary>
        <description lang="en_GB">Launch PC games directly from Kodi. Scans directories for games, fetches metadata and artwork from RAWG, and lets you browse and launch your game library.</description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/opencode/plugin.program.gamelauncher</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>

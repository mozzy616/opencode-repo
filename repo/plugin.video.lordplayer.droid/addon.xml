<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.lordplayer.droid" name="Lordplayer Droid" provider-name="opencode" version="1.0.0">
    <requires>
        <import addon="script.module.requests" version="2.22.0"/>
        <import addon="script.module.routing" version="0.2.3"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="navigation.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <platform>android</platform>
        <license>MIT</license>
        <summary lang="en">Lordplayer Droid - Torrent streaming for Android</summary>
        <description lang="en">Lordplayer Droid is a torrent streaming service with a rest API for Kodi playback on Android devices.</description>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
        <reuselanguageinvoker>true</reuselanguageinvoker>
    </extension>
</addon>
